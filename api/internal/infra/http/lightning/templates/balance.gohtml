<div class="node-balance grid gap-3 md:grid-cols-3">
	<section class="rounded border border-gray-200 p-3">
		<h3 class="font-semibold"><span aria-hidden="true">₿</span> On-chain</h3>
		<dl class="mt-2 space-y-1">
			<div class="flex justify-between gap-2"><dt class="text-gray-600">Confirmed</dt><dd class="font-mono tabular-nums text-right"><span class="font-bold" {{satAttr "data-onchain-confirmed" .OnChain.ConfirmedSat}}>{{.OnChain.ConfirmedSat}}</span> sat <span class="text-gray-500">≈ {{formatBTC .OnChain.ConfirmedSat}} BTC</span></dd></div>
			<div class="flex justify-between gap-2"><dt class="text-gray-600">Unconfirmed</dt><dd class="font-mono tabular-nums text-right"><span class="font-bold" {{satAttr "data-onchain-unconfirmed" .OnChain.UnconfirmedSat}}>{{.OnChain.UnconfirmedSat}}</span> sat <span class="text-gray-500">≈ {{formatBTC .OnChain.UnconfirmedSat}} BTC</span></dd></div>
			<div class="flex justify-between gap-2"><dt class="text-gray-600">Total</dt><dd class="font-mono tabular-nums text-right"><span class="font-bold" {{satAttr "data-onchain-total" .OnChain.TotalSat}}>{{.OnChain.TotalSat}}</span> sat <span class="text-gray-500">≈ {{formatBTC .OnChain.TotalSat}} BTC</span></dd></div>
			{{if gt .OnChain.LockedSat 0}}<div class="flex justify-between gap-2"><dt class="text-gray-600">Locked</dt><dd class="font-mono tabular-nums text-right">{{.OnChain.LockedSat}} sat</dd></div>{{end}}
			{{if gt .OnChain.ReservedAnchorSat 0}}<div class="flex justify-between gap-2"><dt class="text-gray-600">Anchor reserve</dt><dd class="font-mono tabular-nums text-right">{{.OnChain.ReservedAnchorSat}} sat</dd></div>{{end}}
		</dl>
	</section>
	<section class="rounded border border-gray-200 p-3">
		<h3 class="font-semibold"><span aria-hidden="true">⚡</span> Channels</h3>
		<dl class="mt-2 space-y-1">
			<div class="flex justify-between gap-2"><dt class="text-gray-600">Local</dt><dd class="font-mono tabular-nums text-right"><span class="font-bold" data-channels-local="{{.Channels.LocalSat}}">{{.Channels.LocalSat}}</span> sat <span class="text-gray-500">≈ {{formatBTC .Channels.LocalSat}} BTC</span></dd></div>
			<div class="flex justify-between gap-2"><dt class="text-gray-600">Remote</dt><dd class="font-mono tabular-nums text-right"><span class="font-bold" data-channels-remote="{{.Channels.RemoteSat}}">{{.Channels.RemoteSat}}</span> sat <span class="text-gray-500">≈ {{formatBTC .Channels.RemoteSat}} BTC</span></dd></div>
			<div class="flex justify-between gap-2"><dt class="text-gray-600">Pending open (local / remote)</dt><dd class="font-mono tabular-nums text-right">{{.Channels.PendingOpenLocalSat}} / {{.Channels.PendingOpenRemoteSat}} sat</dd></div>
			<div class="flex justify-between gap-2"><dt class="text-gray-600">Unsettled (local / remote)</dt><dd class="font-mono tabular-nums text-right">{{.Channels.UnsettledLocalSat}} / {{.Channels.UnsettledRemoteSat}} sat</dd></div>
			<div class="flex justify-between gap-2"><dt class="text-gray-600">Total local</dt><dd class="font-mono tabular-nums text-right"><span class="font-bold" data-channels-total="{{.Channels.TotalLocalSat}}">{{.Channels.TotalLocalSat}}</span> sat <span class="text-gray-500">≈ {{formatBTC .Channels.TotalLocalSat}} BTC</span></dd></div>
		</dl>
	</section>
	<section class="rounded border border-gray-200 p-3">
		<h3 class="font-semibold">Total</h3>
		<p class="mt-2 font-mono tabular-nums"><span class="font-bold" data-total="{{.TotalSat}}">{{.TotalSat}}</span> sat <span class="text-gray-500">≈ {{formatBTC .TotalSat}} BTC</span></p>
	</section>
</div>
